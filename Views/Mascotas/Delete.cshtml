@model VetCare.Models.Mascota
@{
    ViewData["Title"] = "Eliminar Mascota";
}

<div class="mb-4">
    <h2 class="page-title mb-1 text-danger">Eliminar Mascota</h2>
    <p class="text-muted mb-0">Confirmacion para la baja de registro</p>
</div>

@if (Model.Consultas.Any())
{
    <div class="alert alert-warning mb-4">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
            <div>
                <strong>No es posible eliminar el paciente:</strong>
                Tiene <strong>@Model.Consultas.Count</strong> consulta(s) registrada(s). Debe eliminarse primero su historial medico asociado.
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger mb-4">
        <i class="bi bi-exclamation-circle me-2"></i>
        ¿Esta seguro de que desea eliminar permanentemente este registro?
    </div>
}

<div class="card p-3 mb-4" style="max-width: 500px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">Nombre</dt>
            <dd class="col-sm-8 fw-bold">@Model.Nombre</dd>

            <dt class="col-sm-4 text-muted">Especie</dt>
            <dd class="col-sm-8">@Model.Especie</dd>

            <dt class="col-sm-4 text-muted">Raza</dt>
            <dd class="col-sm-8">@(Model.Raza ?? "—")</dd>

            <dt class="col-sm-4 text-muted">Propietario</dt>
            <dd class="col-sm-8">@Model.NombrePropietario</dd>

            <dt class="col-sm-4 text-muted">Telefono</dt>
            <dd class="col-sm-8">@(Model.TelefonoPropietario ?? "—")</dd>
        </dl>
    </div>
</div>

<div class="d-flex gap-2">
    @if (!Model.Consultas.Any())
    {
        <form asp-action="Delete">
            <input type="hidden" asp-for="IdMascota" />
            <button type="submit" class="btn btn-danger px-4">
                <i class="bi bi-trash me-1"></i> Confirmar Eliminacion
            </button>
        </form>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">
        Cancelar
    </a>
</div>
