@model VetCare.Models.Mascota
@{
    ViewData["Title"] = "Eliminar Mascota";
}

<h2>🗑️ Eliminar Mascota</h2>
<hr />

<div class="alert alert-danger">
    <strong>¿Está seguro de que desea eliminar esta mascota?</strong>
    @if (Model.Consultas.Any())
    {
        <p class="mt-2 mb-0">
            ⚠️ <strong>Esta mascota tiene @Model.Consultas.Count consulta(s) registrada(s).</strong>
            No podrá ser eliminada. Primero debe eliminar su historial médico.
        </p>
    }
</div>

<div class="card" style="max-width: 450px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>

            <dt class="col-sm-4">Especie</dt>
            <dd class="col-sm-8">@Model.Especie</dd>

            <dt class="col-sm-4">Raza</dt>
            <dd class="col-sm-8">@(Model.Raza ?? "—")</dd>

            <dt class="col-sm-4">Propietario</dt>
            <dd class="col-sm-8">@Model.NombrePropietario</dd>

            <dt class="col-sm-4">Teléfono</dt>
            <dd class="col-sm-8">@(Model.TelefonoPropietario ?? "—")</dd>
        </dl>
    </div>
</div>

<div class="d-flex gap-2 mt-3">
    @if (!Model.Consultas.Any())
    {
        <form asp-action="Delete">
            <input type="hidden" asp-for="IdMascota" />
            <button type="submit" class="btn btn-danger">🗑️ Sí, Eliminar</button>
        </form>
    }
    <a asp-action="Index" class="btn btn-secondary">↩ Cancelar</a>
</div>
