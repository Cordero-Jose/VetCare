@model IEnumerable<VetCare.Models.Mascota>
@{
    ViewData["Title"] = "Mascotas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title mb-1">Pacientes Registrados</h2>
        <p class="text-muted mb-0">Gestion y registro de mascotas en el sistema</p>
    </div>
    <a asp-action="Create" class="btn btn-brand-primary">
        <i class="bi bi-plus-lg me-1"></i> Nueva Mascota
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- RF-05: Busqueda por nombre o especie -->
<form method="get" asp-action="Index" class="mb-4">
    <div class="input-group">
        <span class="input-group-text bg-white border-end-0">
            <i class="bi bi-search text-muted"></i>
        </span>
        <input type="text" name="search" value="@ViewBag.Search"
               class="form-control border-start-0" placeholder="Buscar por nombre o especie..." />
        <button type="submit" class="btn btn-brand-primary">Buscar</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-brand-accent">
        <i class="bi bi-info-circle me-2"></i> No se encontraron registros de mascotas.
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <span>Intente con otro termino de busqueda.</span>
        }
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-custom-header">
                    <tr>
                        <th>Nombre</th>
                        <th>Especie</th>
                        <th>Raza</th>
                        <th>Propietario</th>
                        <th>Telefono</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Nombre</strong></td>
                            <td><span class="badge" style="background-color: var(--brand-accent-light); color: var(--brand-dark); font-weight: 500;">@item.Especie</span></td>
                            <td>@(item.Raza ?? "—")</td>
                            <td>@item.NombrePropietario</td>
                            <td>@(item.TelefonoPropietario ?? "—")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-controller="Consultas" asp-action="Historial"
                                       asp-route-mascotaId="@item.IdMascota"
                                       class="btn btn-brand-outline" title="Ver historial">
                                        <i class="bi bi-journal-medical me-1"></i> Historial
                                    </a>
                                    <a asp-controller="Consultas" asp-action="Create"
                                       asp-route-mascotaId="@item.IdMascota"
                                       class="btn btn-brand-secondary" title="Nueva consulta">
                                        <i class="bi bi-plus-circle me-1"></i> Consulta
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.IdMascota"
                                       class="btn btn-outline-secondary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.IdMascota"
                                       class="btn btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
