@model VetCare.Models.Mascota
@{
    ViewData["Title"] = "Nueva Mascota";
}

<div class="mb-4">
    <h2 class="page-title mb-1">Registrar Nueva Mascota</h2>
    <p class="text-muted mb-0">Complete la informacion para dar de alta al paciente</p>
</div>

<div class="row">
    <div class="col-md-7 col-lg-6">
        <div class="card p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-medium"></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Max" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Especie" class="form-label fw-medium"></label>
                    <input asp-for="Especie" class="form-control" placeholder="Ej: Canino, Felino, Ave..." />
                    <span asp-validation-for="Especie" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Raza" class="form-label fw-medium"></label>
                    <input asp-for="Raza" class="form-control" placeholder="Ej: Labrador (opcional)" />
                    <span asp-validation-for="Raza" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaNacimiento" class="form-label fw-medium"></label>
                    <input asp-for="FechaNacimiento" class="form-control" type="date" />
                    <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NombrePropietario" class="form-label fw-medium"></label>
                    <input asp-for="NombrePropietario" class="form-control" placeholder="Nombre completo del propietario" />
                    <span asp-validation-for="NombrePropietario" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="TelefonoPropietario" class="form-label fw-medium"></label>
                    <input asp-for="TelefonoPropietario" class="form-control" placeholder="Ej: 8888-1234 (opcional)" />
                    <span asp-validation-for="TelefonoPropietario" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-brand-primary px-4">
                        <i class="bi bi-save me-1"></i> Guardar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
