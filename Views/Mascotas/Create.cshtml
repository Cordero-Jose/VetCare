@model VetCare.Models.Mascota
@{
    ViewData["Title"] = "Nueva Mascota";
}

<h2>🐾 Registrar Nueva Mascota</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Max" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Especie" class="form-label"></label>
                <input asp-for="Especie" class="form-control" placeholder="Ej: Perro, Gato, Ave..." />
                <span asp-validation-for="Especie" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Raza" class="form-label"></label>
                <input asp-for="Raza" class="form-control" placeholder="Ej: Labrador (opcional)" />
                <span asp-validation-for="Raza" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaNacimiento" class="form-label"></label>
                <input asp-for="FechaNacimiento" class="form-control" type="date" />
                <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NombrePropietario" class="form-label"></label>
                <input asp-for="NombrePropietario" class="form-control" placeholder="Nombre completo del dueño" />
                <span asp-validation-for="NombrePropietario" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TelefonoPropietario" class="form-label"></label>
                <input asp-for="TelefonoPropietario" class="form-control" placeholder="Ej: 8888-1234 (opcional)" />
                <span asp-validation-for="TelefonoPropietario" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">💾 Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">↩ Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
