@model VetCare.Models.Mascota
@{
    ViewData["Title"] = $"Historial - {Model.Nombre}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title mb-1">Historial Clinico</h2>
        <p class="text-muted mb-0">Paciente: <strong>@Model.Nombre</strong></p>
    </div>
    <a asp-controller="Mascotas" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

<div class="card mb-4 shadow-sm border-0">
    <div class="card-header card-header-brand py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-info-circle me-2"></i>Ficha del Paciente</h6>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Especie</dt>
            <dd class="col-sm-3 fw-medium">@Model.Especie</dd>
            <dt class="col-sm-3 text-muted">Raza</dt>
            <dd class="col-sm-3">@(Model.Raza ?? "—")</dd>
            <dt class="col-sm-3 text-muted">Propietario</dt>
            <dd class="col-sm-3">@Model.NombrePropietario</dd>
            <dt class="col-sm-3 text-muted">Telefono</dt>
            <dd class="col-sm-3">@(Model.TelefonoPropietario ?? "—")</dd>
        </dl>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-bold" style="color: var(--brand-dark);">
        Consultas Registradas (@Model.Consultas.Count)
    </h5>
    <a asp-controller="Consultas" asp-action="Create"
       asp-route-mascotaId="@Model.IdMascota"
       class="btn btn-brand-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Nueva Consulta
    </a>
</div>

@if (!Model.Consultas.Any())
{
    <div class="alert alert-brand-accent">
        <i class="bi bi-info-circle me-2"></i> Esta mascota aun no tiene consultas medicas registradas.
    </div>
}
else
{
    <div class="accordion shadow-sm" id="historialAccordion">
        @{int i = 0;}
        @foreach (var consulta in Model.Consultas)
        {
            var collapseId = $"consulta{consulta.IdConsulta}";
            <div class="accordion-item border-0 border-bottom">
                <h2 class="accordion-header">
                    <button class="accordion-button @(i > 0 ? "collapsed" : "")"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId">
                        <span class="me-3 badge text-white" style="background-color: var(--brand-primary); font-weight: normal;">
                            <i class="bi bi-calendar3 me-1"></i> @consulta.FechaConsulta.ToString("dd/MM/yyyy HH:mm")
                        </span>
                        <strong>@consulta.Motivo</strong>
                    </button>
                </h2>
                <div id="@collapseId"
                     class="accordion-collapse collapse @(i == 0 ? "show" : "")"
                     data-bs-parent="#historialAccordion">
                    <div class="accordion-body bg-white">
                        <dl class="row mb-0">
                            <dt class="col-sm-3 text-muted">Diagnostico</dt>
                            <dd class="col-sm-9">@(consulta.Diagnostico ?? "—")</dd>
                            <dt class="col-sm-3 text-muted">Tratamiento</dt>
                            <dd class="col-sm-9">@(consulta.Tratamiento ?? "—")</dd>
                        </dl>
                    </div>
                </div>
            </div>
            i++;
        }
    </div>
}
