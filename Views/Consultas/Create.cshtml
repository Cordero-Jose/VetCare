@model VetCare.Models.Consulta
@{
    ViewData["Title"] = "Registrar Consulta";
    var mascota = ViewBag.Mascota as VetCare.Models.Mascota;
}

<h2>📋 Registrar Consulta Médica</h2>
@if (mascota != null)
{
    <p class="text-muted">Mascota: <strong>@mascota.Nombre</strong> (@mascota.Especie)</p>
}
<hr />

<div class="row">
    <div class="col-md-7">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            @if (mascota == null)
            {
                <div class="mb-3">
                    <label class="form-label">Mascota</label>
                    <select asp-for="IdMascota" asp-items="ViewBag.MascotasSelectList"
                            class="form-select">
                        <option value="">-- Seleccione una mascota --</option>
                    </select>
                    <span asp-validation-for="IdMascota" class="text-danger"></span>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="IdMascota" />
            }

            <div class="mb-3">
                <label asp-for="FechaConsulta" class="form-label"></label>
                <input asp-for="FechaConsulta" class="form-control" type="datetime-local"
                       max="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="FechaConsulta" class="text-danger"></span>
                <div class="form-text">No se permiten fechas futuras.</div>
            </div>

            <div class="mb-3">
                <label asp-for="Motivo" class="form-label"></label>
                <input asp-for="Motivo" class="form-control"
                       placeholder="Ej: Vacunación, Chequeo general, Cojera..." />
                <span asp-validation-for="Motivo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Diagnostico" class="form-label"></label>
                <textarea asp-for="Diagnostico" class="form-control" rows="3"
                          placeholder="Resultado del examen (opcional)"></textarea>
                <span asp-validation-for="Diagnostico" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tratamiento" class="form-label"></label>
                <textarea asp-for="Tratamiento" class="form-control" rows="3"
                          placeholder="Medicación o indicaciones (opcional)"></textarea>
                <span asp-validation-for="Tratamiento" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">💾 Guardar Consulta</button>
                @if (mascota != null)
                {
                    <a asp-controller="Consultas" asp-action="Historial"
                       asp-route-mascotaId="@mascota.IdMascota"
                       class="btn btn-secondary">↩ Ver Historial</a>
                }
                else
                {
                    <a asp-controller="Mascotas" asp-action="Index"
                       class="btn btn-secondary">↩ Cancelar</a>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
